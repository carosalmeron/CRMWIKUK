{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/pbi-sync",
      "schedule": "0 4 * * 1-6"
    },
    {
      "path": "/api/pbi-sync?full=1",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/pbi-sync?mesescliente=1",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/pbi-sync?estacionalidad=1",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/pbi-sync?resumen=1",
      "schedule": "35 5 * * *"
    }
  ]
}
