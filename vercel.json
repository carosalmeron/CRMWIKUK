{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/pbi-sync?maestro=1&fusiones=1&sinpedidos=1", "schedule": "30 4 * * *" },
    { "path": "/api/pbi-sync?full=1&sinpedidos=1",               "schedule": "45 5 * * *" },
    { "path": "/api/pbi-sync?resumen=1",                          "schedule": "5 6 * * *" },
    { "path": "/api/pbi-sync?solopedidos=1",                      "schedule": "15 6 * * *" },
    { "path": "/api/pbi-sync?mesescliente=1",                     "schedule": "20 6 * * *" },
    { "path": "/api/pbi-sync?estacionalidad=1",                   "schedule": "25 6 * * *" },
    { "path": "/api/pbi-sync?full=1&sinpedidos=1",                "schedule": "30 15 * * *" },
    { "path": "/api/pbi-sync?resumen=1",                          "schedule": "50 15 * * *" },
    { "path": "/api/pbi-sync?cierre=1",                           "schedule": "0 16 * * 5" }
  ]
}
